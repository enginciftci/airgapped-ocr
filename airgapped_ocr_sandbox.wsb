<Configuration>
  <Networking>Disable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>.</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\airgapped ocr</SandboxFolder>
      <ReadOnly>false</ReadOnly>
