  <LogonCommand>
    <Command>cmd.exe /c start cmd.exe /k "cd /d ""C:\Users\WDAGUtilityAccount\Desktop\airgapped ocr"" &amp;&amp; echo === Air-Gapped OCR Sandbox Ready === &amp;&amp; echo Example: portable_ocr\run_ocr.bat 42-47.jpg"</Command>
